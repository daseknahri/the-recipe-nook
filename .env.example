# The Recipe Nook — environment template. Copy to .env for LOCAL runs and fill in fresh
# random values (never reuse a sibling site's .env). .env is gitignored.
# In production these come from Coolify (SERVICE_* are Coolify magic variables).

# --- Local Docker / MySQL (Coolify generates its own SERVICE_* in production) ---
SERVICE_USER_MYSQL=recipeswp
SERVICE_PASSWORD_MYSQL=change-me-long-random
SERVICE_PASSWORD_MYSQLROOT=change-me-long-random
SERVICE_PASSWORD_WPADMIN=change-me-long-random

# --- WordPress admin (first install only) ---
WP_ADMIN_USER=editor
WP_ADMIN_PASSWORD=change-me-long-random
WP_ADMIN_EMAIL=daseknahri@gmail.com

# --- Site identity ---
SITE_URL=https://therecipenook.getemoji.site
SITE_EMAIL=daseknahri@gmail.com

# --- WordPress salts (local only; generate 8 unique 64-char random strings) ---
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# --- AdSense, two-stage (same publisher as the getemoji.site family) ---
# STAGE 1 (verify + review): ADSENSE_ENABLE=0 — the site still serves /ads.txt from
# ADSENSE_PUB_ID so it can be added and reviewed in AdSense without showing a single ad.
# STAGE 2 (go live): ADSENSE_ENABLE=1 only after approval + Privacy & Messaging (CMP).
ADSENSE_CLIENT=ca-pub-6869205417923902
ADSENSE_PUB_ID=pub-6869205417923902
ADSENSE_ENABLE=0

# --- Analytics (off until the owner creates the properties) ---
GA_ENABLE=0
GA_MEASUREMENT_ID=
HISTATS_ID=off
